---
import grid from '../data/grid.json';

type Item = {
  kind: 'work' | 'doodle' | 'text';
  size?: '1x1' | '2x1' | '2x2';
  title?: string;
  text?: string;
  image?: string;
  alt?: string;
  link?: string;
};

const items = grid.items as Item[];
// Doodles are always 2x1; text cards are 1x1 or 2x1.
const sizeOf = (item: Item) => {
  if (item.kind === 'doodle') return '2x1';
  if (item.kind === 'text') return item.size === '1x1' ? '1x1' : '2x1';
  return item.size ?? '1x1';
};
---

<div class="grid-wrap">
<div class="grid">
  {items.map((item) => {
    const size = sizeOf(item);
    // Inside a link the title names the tile, so the image is decorative there.
    const media = (alt: string) => item.image
      ? <img src={item.image} alt={alt} loading="lazy" />
      : <span class="placeholder">{item.title}</span>;

    if (item.kind === 'text') {
      const words = <p class="h3">{item.text}</p>;
      return item.link
        ? <a class={`tile text s-${size}`} href={item.link}>{words}</a>
        : <div class={`tile text s-${size}`}>{words}</div>;
    }
    if (item.kind === 'doodle') {
      return <div class={`tile doodle s-${size}`}>{media(item.alt ?? '')}</div>;
    }
    return item.link
      ? (
        <a class={`tile work s-${size}`} href={item.link}>
          {media('')}
          <span class="label">{item.title}</span>
        </a>
      )
      : <div class={`tile work s-${size}`}>{media(item.alt ?? '')}</div>;
  })}
</div>
</div>

<style>
  /* The wrapper is the size container; the grid measures it to make square rows. */
  .grid-wrap {
    container-type: inline-size;
    margin: 0 0 4rem;
  }
  .grid {
    --cols: 4;
    --gap: 16px;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    /* Rows match column width so a 1x1 tile is square. */
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
    grid-auto-flow: dense;
    gap: var(--gap);
  }
  @media (max-width: 640px) {
    .grid { --cols: 2; --gap: 12px; }
  }

  .tile {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: color-mix(in srgb, var(--fg) 6%, transparent);
    color: inherit;
    text-decoration: none;
  }
  .s-2x1 { grid-column: span 2; }
  .s-2x2 { grid-column: span 2; grid-row: span 2; }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    position: absolute;
    inset: auto 0 0 0;
    padding: 12px 14px;
    font: var(--type-caption);
    color: var(--muted);
  }

  /* Text cards: Redaction h3, top-left. */
  .text {
    display: flex;
    padding: 24px;
    box-sizing: border-box;
  }
  .text p { margin: 0; }

  /* Linked tiles lift slightly; work tiles also reveal a polaroid-style title bar. */
  a.tile {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a.tile:hover,
  a.tile:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.06),
      0 12px 24px -6px rgb(0 0 0 / 0.16);
  }
  a.tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .label {
    position: absolute;
    inset: auto 10px 10px 10px;
    padding: 10px 14px;
    border-radius: 8px;
    background: #fff;
    color: #2c2c2a;
    font: var(--type-h5);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }
  a.work:hover .label,
  a.work:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    a.tile, .label { transition: opacity 0.2s ease; }
    a.tile:hover, a.tile:focus-visible { transform: none; }
    .label { transform: none; }
  }

  .doodle { background: transparent; border: 1px dashed color-mix(in srgb, var(--fg) 15%, transparent); }
  .doodle img { object-fit: contain; }
</style>
