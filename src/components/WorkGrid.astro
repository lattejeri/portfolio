---
import grid from '../data/grid.json';

type Item = {
  kind: 'work' | 'doodle' | 'text';
  size?: '1x1' | '2x1' | '2x2';
  title?: string;
  text?: string;
  icon?: string;
  image?: string;
  alt?: string;
  link?: string;
};

const items = grid.items as Item[];
// Doodles are always 2x1; text cards are 1x1 or 2x1.
const sizeOf = (item: Item) => {
  if (item.kind === 'doodle') return '2x1';
  if (item.kind === 'text') return item.size === '1x1' ? '1x1' : '2x1';
  return item.size ?? '1x1';
};
---

<div class="grid-wrap">
<div class="grid">
  {items.map((item) => {
    const size = sizeOf(item);
    // Inside a link the title names the tile, so the image is decorative there.
    const media = (alt: string) => item.image
      ? <img src={item.image} alt={alt} loading="lazy" />
      : <span class="placeholder">{item.title}</span>;

    if (item.kind === 'text') {
      // Icon is decorative; the card text says what the topic is.
      const words = (
        <>
          {item.image && <img class="card-bg" src={item.image} alt="" aria-hidden="true" loading="lazy" />}
          {item.icon
            ? <img class="icon" src={item.icon} alt="" width="48" height="48" />
            : <span class="icon icon-empty" aria-hidden="true" />}
          <p class="h3">{item.text}</p>
        </>
      );
      return item.link
        ? <a class={`tile text s-${size}`} href={item.link}>{words}<span class="arrow" aria-hidden="true">→</span></a>
        : <div class={`tile text s-${size}`}>{words}</div>;
    }
    if (item.kind === 'doodle') {
      return (
        <div class={`tile doodle s-${size}`}>
          <svg class="squiggle" aria-hidden="true" focusable="false"><path /></svg>
          {item.image
            ? <img src={item.image} alt={item.alt ?? ''} loading="lazy" />
            : <p class="h4 font-redaction doodle-text">{item.title}</p>}
        </div>
      );
    }
    return item.link
      ? (
        <a class={`tile work s-${size}`} href={item.link}>
          {media('')}
          <span class="label">{item.title}</span>
        </a>
      )
      : <div class={`tile work s-${size}`}>{media(item.alt ?? '')}</div>;
  })}
</div>
</div>

<style>
  /* The wrapper is the size container; the grid measures it to make square rows. */
  .grid-wrap {
    container-type: inline-size;
  }
  .grid {
    --cols: 4;
    --gap: 16px;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    /* Rows match column width so a 1x1 tile is square. */
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols));
    grid-auto-flow: dense;
    gap: var(--gap);
  }
  @media (max-width: 640px) {
    .grid { --cols: 2; --gap: 12px; }
  }

  .tile {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background: var(--bg);
    color: inherit;
    text-decoration: none;
  }
  .s-2x1 { grid-column: span 2; }
  .s-2x2 { grid-column: span 2; grid-row: span 2; }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .placeholder {
    position: absolute;
    inset: auto 0 0 0;
    padding: 12px 14px;
    font: var(--type-caption);
    color: var(--muted);
  }

  /* Text cards: Redaction h3, top-left. */
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 24px;
    box-sizing: border-box;
  }
  .text p { margin: 0; }
  .text > :not(.card-bg, .arrow) { position: relative; } /* keep icon and text above the image (arrow is already absolute) */

  /*
    Optional background image on text cards, at full opacity.
    2x1: anchored right. 1x1: anchored bottom-centre.
  */
  .tile .card-bg {
    position: absolute;
    object-fit: contain;
    pointer-events: none;
  }
  .text.s-2x1 .card-bg {
    top: 0;
    right: 0;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-position: right center;
  }
  .text.s-1x1 .card-bg {
    bottom: 0;
    left: 50%;
    translate: -50% 0;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-position: center bottom;
  }
  .tile .icon {
    flex: none;
    width: 48px;
    height: 48px;
    object-fit: contain;
  }
  /* Marks the icon space until a doodle is added. */
  .icon-empty {
    box-sizing: border-box;
    border: 1px dashed color-mix(in srgb, var(--fg) 20%, transparent);
    border-radius: 8px;
  }
  .arrow {
    position: absolute;
    right: 20px;
    bottom: 16px;
    font: var(--type-h3);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }
  a.text:hover .arrow,
  a.text:focus-visible .arrow {
    opacity: 1;
    transform: none;
  }

  /* Linked tiles lift slightly; work tiles also reveal a polaroid-style title bar. */
  a.tile {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a.tile:hover,
  a.tile:focus-visible {
    transform: translateY(-4px);
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.06),
      0 12px 24px -6px rgb(0 0 0 / 0.16);
  }
  a.tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .label {
    position: absolute;
    inset: auto 10px 10px 10px;
    padding: 10px 14px;
    border-radius: 8px;
    background: #fff;
    color: #2c2c2a;
    font: var(--type-h5);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.2s ease, transform 0.25s ease;
  }
  a.work:hover .label,
  a.work:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    a.tile, .label, .arrow { transition: opacity 0.2s ease; }
    a.tile:hover, a.tile:focus-visible { transform: none; }
    .label, .arrow { transform: none; }
  }

  /* Doodles sit straight on the dark band; wording is centred, h4 size in Redaction, in paper. */
  .doodle {
    display: grid;
    place-items: center;
    padding: 24px;
    box-sizing: border-box;
    background: transparent;
  }
  .doodle img { position: absolute; inset: 0; }
  .doodle { overflow: visible; } /* let the squiggle break the frame */
  .doodle-text { position: relative; } /* text above the squiggle */

  /* Random squiggle, drawn by the script below; may spill up to 20px outside the tile. */
  .squiggle {
    position: absolute;
    inset: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 40px);
    overflow: visible;
    pointer-events: none;
  }
  .squiggle path {
    fill: none;
    stroke: var(--squiggle, var(--viz-focus-line));
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .squiggle.drawing path {
    animation: draw 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .squiggle.drawing path { animation: none; stroke-dashoffset: 0; }
  }
  .doodle-text {
    margin: 0;
    text-align: center;
    color: var(--viz-neutral-paper);
  }
  .doodle img { object-fit: contain; }
</style>

<script>
  // Draws a random marker squiggle in each doodle tile, in one of the palette's line colours.
  const colours = ['data', 'people', 'system', 'friction', 'focus'].map((f) => `var(--viz-${f}-line)`);
  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const SPILL = 20; // px the squiggle may extend past the tile
  const INSET = 12; // keep points this far inside the spill edge (curves bulge slightly past their points)

  // Smooth curve through points (Catmull-Rom converted to cubic Béziers).
  const smoothPath = (pts: [number, number][]) => {
    let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
      const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
      const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
      d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
    }
    return d;
  };

  const squiggle = (w: number, h: number) => {
    // Bounds include the spill margin; the SVG is offset by -SPILL so 0..w+2*SPILL covers it.
    const W = w + SPILL * 2, H = h + SPILL * 2;
    const size = Math.min(w, h);
    const pts: [number, number][] = [];
    let x = rand(0.2, 0.8) * W, y = rand(0.2, 0.8) * H;
    let angle = rand(0, Math.PI * 2);
    const count = Math.round(rand(6, 10));
    for (let i = 0; i < count; i++) {
      pts.push([x, y]);
      angle += rand(-1.6, 1.6); // wander, with the odd sharp turn
      const step = rand(0.18, 0.4) * size;
      x += Math.cos(angle) * step;
      y += Math.sin(angle) * step;
      // Bounce off the spill-extended edges, inset a little for curve bulge and stroke width.
      if (x < INSET || x > W - INSET) { angle = Math.PI - angle; x = Math.min(Math.max(x, INSET), W - INSET); }
      if (y < INSET || y > H - INSET) { angle = -angle; y = Math.min(Math.max(y, INSET), H - INSET); }
    }
    return { d: smoothPath(pts), viewBox: `0 0 ${W} ${H}` };
  };

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      e.target.classList.add('drawing');
      io.unobserve(e.target);
    }
  }, { threshold: 0.4 });

  for (const svg of document.querySelectorAll<SVGSVGElement>('.doodle .squiggle')) {
    const tile = svg.parentElement!;
    const { d, viewBox } = squiggle(tile.clientWidth, tile.clientHeight);
    const path = svg.querySelector('path')!;
    svg.setAttribute('viewBox', viewBox);
    svg.setAttribute('preserveAspectRatio', 'none');
    path.setAttribute('d', d);
    path.style.setProperty('--squiggle', colours[Math.floor(Math.random() * colours.length)]);
    const len = path.getTotalLength();
    path.style.strokeDasharray = `${len}`;
    path.style.strokeDashoffset = `${len}`;
    io.observe(svg);
  }
</script>
