---
interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

<section class="carousel" aria-roledescription="carousel" aria-label="Image carousel">
  <div class="track" tabindex="0">
    {images.map((img, i) => (
      <figure class="slide" aria-label={`${i + 1} of ${images.length}`}>
        <img src={img.src} alt={img.alt} loading={i < 2 ? 'eager' : 'lazy'} draggable="false" />
      </figure>
    ))}
  </div>
  {images.length > 1 && (
    <div class="controls">
      <button type="button" class="prev" aria-label="Previous image" disabled>←</button>
      <button type="button" class="next" aria-label="Next image">→</button>
    </div>
  )}
</section>

<style>
  /*
    The track spans the full page width. Its left padding equals the text column's
    left edge (the "spine"), and snapping aligns each slide to that same edge.
  */
  /* Sits on a dark band like the homepage grid: same colour, same 64px top/bottom padding. */
  .carousel {
    background: var(--fg);
    color: var(--bg);
    padding-block: 64px;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    --spine: max(16px, calc((100% - 960px) / 2));
    --gap: 24px;
    --height: clamp(240px, 42vw, 560px);
  }
  .track {
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline-start: var(--spine);
    padding-inline-start: var(--spine);
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  /* Spacer so the last slide can clear the right edge (flex ignores end padding when scrolling). */
  .track::after {
    content: '';
    flex: 0 0 calc(var(--spine) - var(--gap));
  }
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .slide {
    flex: none;
    margin: 0;
    scroll-snap-align: start;
  }
  /* Mouse users can drag the strip; a peeking slide can be clicked to bring it into place. */
  .track { cursor: grab; user-select: none; }
  .track.dragging { cursor: grabbing; }
  .slide:not(.current) { cursor: pointer; }
  .slide img {
    display: block;
    height: var(--height);
    width: auto;
    max-width: none;
    border-radius: 4px;
  }

  .controls {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    padding-inline-start: var(--spine);
  }
  .controls button {
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font: var(--type-h5);
    cursor: pointer;
    transition: background 0.15s ease, opacity 0.15s ease;
  }
  .controls button:hover:not(:disabled) {
    background: color-mix(in srgb, currentColor 12%, transparent);
  }
  .controls button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .controls button:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (max-width: 640px) {
    .carousel { --gap: 12px; --height: 64vw; }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const carousel of document.querySelectorAll<HTMLElement>('.carousel')) {
    const track = carousel.querySelector<HTMLElement>('.track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const prev = carousel.querySelector<HTMLButtonElement>('.prev');
    const next = carousel.querySelector<HTMLButtonElement>('.next');

    // Scroll position that lines a slide up with the spine (where snapping aligns it).
    const spine = () => slides[0].offsetLeft - track.offsetLeft;
    const target = (s: HTMLElement) => s.offsetLeft - track.offsetLeft - spine();
    const maxScroll = () => track.scrollWidth - track.clientWidth;

    const current = () => {
      let index = 0;
      slides.forEach((s, i) => { if (target(s) <= track.scrollLeft + 4) index = i; });
      return index;
    };

    const go = (i: number) => {
      i = Math.min(slides.length - 1, Math.max(0, i));
      track.scrollTo({ left: Math.min(target(slides[i]), maxScroll()), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    const update = () => {
      const i = current();
      slides.forEach((s, j) => s.classList.toggle('current', j === i));
      if (prev) prev.disabled = track.scrollLeft <= 4;
      if (next) next.disabled = track.scrollLeft >= maxScroll() - 4;
    };

    prev?.addEventListener('click', () => go(current() - 1));
    next?.addEventListener('click', () => go(current() + 1));

    // Mouse drag to swipe (touch and trackpads already scroll natively).
    let drag: { x: number; scroll: number; start: number; moved: boolean } | null = null;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      suppressClick = false;
      drag = { x: e.clientX, scroll: track.scrollLeft, start: current(), moved: false };
    });
    track.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved) {
        if (Math.abs(dx) <= 5) return; // still a click, not a drag
        // Only capture once it's a real drag, so plain clicks still reach the slide.
        drag.moved = true;
        track.classList.add('dragging');
        track.style.scrollSnapType = 'none'; // let the strip follow the mouse freely
        track.setPointerCapture(e.pointerId);
      }
      track.scrollLeft = drag.scroll - dx;
    });
    const endDrag = (e: PointerEvent) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      const { start, moved } = drag;
      drag = null;
      track.classList.remove('dragging');
      if (moved) {
        // A deliberate drag moves one slide in that direction; a small one settles back.
        const to = Math.abs(dx) > 40 ? start + (dx < 0 ? 1 : -1) : start;
        go(to);
        suppressClick = true;
        const restore = () => { track.style.scrollSnapType = ''; };
        if ('onscrollend' in window) track.addEventListener('scrollend', restore, { once: true });
        else setTimeout(restore, 500);
      }
    };
    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // Click / tap a peeking slide to bring it into place. Listen on the track: after a
    // drag the browser sends the click to the track (pointer capture), not the slide.
    let suppressClick = false;
    track.addEventListener('click', (e) => {
      if (suppressClick) { suppressClick = false; return; }
      const slide = (e.target as HTMLElement).closest<HTMLElement>('.slide');
      if (!slide) return;
      const i = slides.indexOf(slide);
      if (i !== current()) go(i);
    });

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
