---
import type { CollectionEntry } from 'astro:content';
import Carousel from './Carousel.astro';
import Showcase from './Showcase.astro';

interface Props {
  blocks: CollectionEntry<'work'>['data']['blocks'];
}

const { blocks } = Astro.props;
---

{blocks.map((block) => {
  switch (block.type) {
    case 'text':
      return (
        <div class="wrap block">
          <div class="measure prose" set:html={block.body} />
        </div>
      );
    case 'image':
      return (
        <figure class="bleed block">
          <img class:list={{ framed: block.framed }} src={block.src} alt={block.alt} loading="lazy" />
          {block.caption && <figcaption class="wrap caption">{block.caption}</figcaption>}
        </figure>
      );
    case 'imageInline':
      return (
        <figure class="wrap block">
          <img class:list={["measure", { framed: block.framed }]} src={block.src} alt={block.alt} loading="lazy" />
          {block.caption && <figcaption class="caption measure">{block.caption}</figcaption>}
        </figure>
      );
    case 'imageWide':
      return (
        <figure class="wide block">
          <img class:list={{ framed: block.framed }} src={block.src} alt={block.alt} loading="lazy" />
          {block.caption && <figcaption class="wrap caption">{block.caption}</figcaption>}
        </figure>
      );
    case 'carousel':
      return (
        <div class="block">
          <Carousel images={block.images} framed={block.framed} />
        </div>
      );
    case 'showcase':
      return (
        <div class="block showcase-block">
          <Showcase desktop={block.desktop} mobile={block.mobile} alt={block.alt} height={block.height} />
        </div>
      );
    case 'embed':
      return (
        <div class="block embed">
          <div class="embed-inner">
            <img class="embed-cue" src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/media/play-with-me.svg`} alt="Play with me" width="172" height="73" />
            <iframe
              src={block.src}
              title={block.title}
              loading="lazy"
              style={`--embed-height: ${block.height}px`}
            />
          </div>
        </div>
      );
    case 'columns2':
    case 'columns3':
      return (
        <div class={`bleed block cols ${block.type}`}>
          {block.images.map((img) => <img class:list={{ framed: block.framed }} src={img.src} alt={img.alt} loading="lazy" />)}
        </div>
      );
  }
})}

<style>
  .block { margin-block: 0 64px; }

  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(> :last-child) { margin-bottom: 0; }

  /* Breakout blocks span the viewport with a 32px margin each side. */
  .bleed {
    box-sizing: border-box;
    margin-inline: 0;
    padding-inline: 32px;
  }
  .bleed img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Inline image: 800px, left-aligned with the text column. */
  figure.wrap img {
    display: block;
    width: 100%;
  }

  /* Wide image: wider than the text, capped at 1200px and centred on the page. */
  .wide {
    box-sizing: border-box;
    margin-inline: 0;
    padding-inline: 32px;
  }
  .wide img {
    display: block;
    width: 100%;
    max-width: 1200px;
    height: auto;
    margin-inline: auto;
  }

  /* "Rounded corners" option. */
  img.framed {
    border-radius: 8px;
  }

  /* Image captions sit under the image, aligned to the text column. */
  figcaption.caption { margin-top: 12px; }

  /* Embedded pages (e.g. the Research HQ style guide): up to 1200px, centred, so they can break the text spine. */
  .embed, .showcase-block { padding-inline: 32px; }
  .embed-inner {
    max-width: 1200px;
    margin-inline: auto;
  }
  /* "Play with me" cue, left-aligned to the iframe. */
  .embed-cue {
    display: block;
    margin-bottom: 20px;
  }
  .embed iframe {
    display: block;
    width: 100%;
    height: min(var(--embed-height), 85vh);
    box-sizing: border-box;
    border: 1px solid #e6e1da;
    border-radius: 8px;
    background: #fff;
  }

  .cols {
    display: grid;
    gap: 32px;
    align-items: start;
  }
  .columns2 { grid-template-columns: repeat(2, 1fr); }
  .columns3 { grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 640px) {
    .bleed, .wide, .embed, .showcase-block { padding-inline: 16px; }
    .cols { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
