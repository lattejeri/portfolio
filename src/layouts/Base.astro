---
import { Font } from 'astro:assets';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-redaction" preload />
    <Font cssVariable="--font-redaction-10" />
    <Font cssVariable="--font-redaction-20" />
    <Font cssVariable="--font-redaction-35" />
    <Font cssVariable="--font-redaction-50" />
    <Font cssVariable="--font-redaction-70" />
    <Font cssVariable="--font-redaction-100" />
  </head>
  <body>
    <header class="wrap">
      <a href={`${base}/`}>{site.title}</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfc;
    --fg: #2c2c2a;
    --muted: #6b6b66;
    --accent: #2f5bd3;
    /* Very subtle terrazzo: #FAF9F5 chips on #FDFDFC. */
    --texture: url('../assets/textures/terrazzo.svg');
    color-scheme: light dark;

    /* Type ramp — weight size/line-height family */
    --type-h1: 400 72px/76px var(--font-redaction);
    --type-h2: 400 48px/56px var(--font-redaction);
    --type-h3: 400 32px/40px var(--font-redaction);
    --type-h4: 600 22px/32px var(--font-inter-tight);
    --type-h5: 600 18px/28px var(--font-inter-tight);
    --type-p1: 500 24px/40px var(--font-inter-tight);
    --type-p2: 400 18px/28px var(--font-inter-tight);
    --type-caption: 400 14px/20px var(--font-inter-tight);
  }
  @media (max-width: 640px) {
    :root {
      --type-h1: 400 44px/48px var(--font-redaction);
      --type-h2: 400 34px/40px var(--font-redaction);
      --type-h3: 400 26px/32px var(--font-redaction);
      --type-p1: 500 20px/32px var(--font-inter-tight);
    }
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615;
      --fg: #ececea;
      --muted: #9a9a94;
      --accent: #8aa8ff;
      --texture: none;
    }
  }
  body {
    margin: 0;
    padding: 2rem 0 4rem;
    background: var(--bg) var(--texture) repeat;
    color: var(--fg);
    font: var(--type-p2);
  }

  /* Headings get their ramp style by default; classes apply a style to any element. */
  h1, .h1 { font: var(--type-h1); letter-spacing: -0.01em; }
  h2, .h2 { font: var(--type-h2); letter-spacing: -0.005em; }
  h3, .h3 { font: var(--type-h3); }
  h4, .h4 { font: var(--type-h4); }
  h5, .h5 { font: var(--type-h5); }
  .p1 { font: var(--type-p1); }
  .p2 { font: var(--type-p2); }
  .caption { font: var(--type-caption); color: var(--muted); }

  h1, h2, h3, h4, h5 { margin: 0 0 0.5em; }
  p { margin: 0 0 1em; }
  * + :is(h2, h3, h4, h5) { margin-top: 1.5em; }
  a { color: var(--accent); }
  header { margin-bottom: 3rem; }
  header a {
    color: inherit;
    font-family: var(--font-redaction-50);
    text-decoration: none;
  }
  img { max-width: 100%; height: auto; }

  /* 960px content wrapper; breakout blocks (e.g. full-width images) sit outside it. */
  .wrap {
    box-sizing: border-box;
    max-width: calc(960px + 2rem);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* 800px text column, left-aligned inside .wrap. */
  .measure { max-width: 800px; }

  .p1 a {
    display: inline-block;
    padding: 0 0.35em;
    border-radius: 0.3em;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
    text-decoration: none;
  }
  .p1 a:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
</style>
