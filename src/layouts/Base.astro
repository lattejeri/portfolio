---
import { Font } from 'astro:assets';
import site from '../data/site.json';
import '../styles/palette.css';

interface Props {
  title?: string;
  description?: string;
  /** Let the last section run to the bottom of the page (no bottom padding). */
  flushBottom?: boolean;
}

const { title, description = site.description, flushBottom = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  { label: 'Work', href: `${base}/work/` },
  { label: 'Bio', href: `${base}/bio/` },
  { label: 'LinkedIn', href: site.linkedin, external: true },
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-redaction" preload />
    <Font cssVariable="--font-redaction-10" />
    <Font cssVariable="--font-redaction-20" />
    <Font cssVariable="--font-redaction-35" />
    <Font cssVariable="--font-redaction-50" />
    <Font cssVariable="--font-redaction-70" />
    <Font cssVariable="--font-redaction-100" preload />
  </head>
  <body>
    <header class="wrap site-header">
      <a class="logo" href={`${base}/`} aria-label={`${site.title} — home`}>Jeremy</a>
      <nav aria-label="Main">
        <ul>
          {nav.map(({ label, href, external }) => (
            <li>
              {external
                ? <a href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true"> ↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
                : <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>}
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main class:list={{ flush: flushBottom }}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: var(--viz-neutral-paper-light);
    --fg: var(--viz-neutral-ink);
    --muted: #6b6b66;
    --accent: #2f5bd3;
    /* Eggshell patches (#F1EFE8) + pixel dust (#888780, #444441) on #FDFDFC. */
    --texture: url('../assets/textures/noise.svg');
    color-scheme: light; /* dark mode disabled for now — see git history for the old palette */

    /* Type ramp — weight size/line-height family */
    --type-h1: 400 72px/76px var(--font-redaction);
    --type-h2: 400 48px/56px var(--font-redaction);
    --type-h3: 400 32px/40px var(--font-redaction);
    --type-h4: 600 22px/32px var(--font-inter-tight);
    --type-h5: 600 18px/28px var(--font-inter-tight);
    --type-p1: 500 24px/40px var(--font-inter-tight);
    --type-p2: 400 18px/28px var(--font-inter-tight);
    --type-caption: 400 14px/20px var(--font-inter-tight);
  }
  @media (max-width: 640px) {
    :root {
      --type-h1: 400 44px/48px var(--font-redaction);
      --type-h2: 400 34px/40px var(--font-redaction);
      --type-h3: 400 26px/32px var(--font-redaction);
      --type-p1: 500 20px/32px var(--font-inter-tight);
    }
  }
  /* Always reserve scrollbar space so centred content doesn't shift between short and long pages. */
  html { overflow-y: scroll; scrollbar-gutter: stable; }
  body {
    margin: 0;
    padding: 2rem 0 0;
    background: var(--bg);
    color: var(--fg);
    font: var(--type-p2);
  }

  /* Headings get their ramp style by default; classes apply a style to any element. */
  /* Texture sits on a fixed layer so it stays put while the page scrolls (works on iOS too). */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    background: var(--texture) repeat;
    pointer-events: none;
  }

  /* Tables: hairline #F1EFE8 grid with rounded outer corners. */
  table {
    width: 100%;
    margin: 0 0 1em;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid var(--viz-structure-tint);
    border-radius: 8px;
    overflow: hidden;
  }
  th, td {
    padding: 12px 16px;
    text-align: left;
    vertical-align: top;
    border-right: 1px solid var(--viz-structure-tint);
    border-bottom: 1px solid var(--viz-structure-tint);
  }
  :is(th, td):last-child { border-right: 0; }
  tr:last-child > :is(th, td) { border-bottom: 0; }
  :is(th, td) > p { margin: 0; }
  :is(th, td) > p + p { margin-top: 0.5em; }

  h1, .h1 { font: var(--type-h1); letter-spacing: -0.01em; }
  h2, .h2 { font: var(--type-h2); letter-spacing: -0.005em; }
  h3, .h3 { font: var(--type-h3); }
  h4, .h4 { font: var(--type-h4); }
  h5, .h5 { font: var(--type-h5); }
  .p1 { font: var(--type-p1); }
  .p2 { font: var(--type-p2); }
  .caption { font: var(--type-caption); color: var(--muted); }

  /* Modifier: keep a ramp style's size/leading but set it in Redaction, e.g. class="h4 font-redaction". */
  .font-redaction { font-family: var(--font-redaction); font-weight: 400; }

  h1, h2, h3, h4, h5 { margin: 0 0 0.5em; }
  p { margin: 0 0 1em; }
  * + :is(h2, h3, h4, h5) { margin-top: 1.5em; }
  a { color: var(--accent); }
  .site-header {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 40px;
    margin-bottom: 3rem;
  }
  .site-header a {
    color: inherit;
    text-decoration: none;
  }
  .logo {
    /* Fixed box (fits "Jeremy") so the nav doesn't nudge when the font loads. */
    display: inline-block;
    width: 84px;
    white-space: nowrap;
    font-family: var(--font-redaction-100);
    font-size: 24px;
    line-height: 1;
  }
  .site-header ul {
    display: flex;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header nav a {
    font-weight: 500;
    color: var(--fg);
    text-decoration: underline 1px transparent;
    text-underline-offset: 6px;
    transition: text-decoration-color 0.15s ease;
  }
  /* Links are always ink; an underline marks hover and the current section. */
  .site-header nav a:hover,
  .site-header nav a[aria-current='page'] { text-decoration-color: currentColor; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  main { padding-bottom: 4rem; }
  main.flush { padding-bottom: 0; }
  img { max-width: 100%; height: auto; }

  /* 960px content wrapper; breakout blocks (e.g. full-width images) sit outside it. */
  .wrap {
    box-sizing: border-box;
    max-width: calc(960px + 2rem);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* 800px text column, left-aligned inside .wrap. */
  .measure { max-width: 800px; }

  .p1 a {
    display: inline-block;
    padding: 0 0.35em;
    border-radius: 0.3em;
    background: var(--viz-focus-tint); /* dusty pink-white */
    color: var(--fg);
    text-decoration: none;
  }
  .p1 a:hover {
    background: color-mix(in srgb, var(--viz-focus-tint), var(--viz-focus-line) 12%);
  }
</style>
