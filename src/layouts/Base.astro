---
import { Font } from 'astro:assets';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <Font cssVariable="--font-inter-tight" preload />
    <Font cssVariable="--font-redaction" preload />
    <Font cssVariable="--font-redaction-10" />
    <Font cssVariable="--font-redaction-20" />
    <Font cssVariable="--font-redaction-35" />
    <Font cssVariable="--font-redaction-50" />
    <Font cssVariable="--font-redaction-70" />
    <Font cssVariable="--font-redaction-100" />
  </head>
  <body>
    <header class="wrap">
      <a href={`${base}/`}>{site.title}</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fdfdfc;
    --fg: #1c1c1a;
    --muted: #6b6b66;
    --accent: #2f5bd3;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615;
      --fg: #ececea;
      --muted: #9a9a94;
      --accent: #8aa8ff;
    }
  }
  body {
    margin: 0;
    padding: 2rem 0 4rem;
    background: var(--bg);
    color: var(--fg);
    font: 1.0625rem/1.65 var(--font-inter-tight);
  }
  h1, h2, h3, h4 { font-family: var(--font-redaction); font-weight: 400; }
  a { color: var(--accent); }
  header { margin-bottom: 3rem; }
  header a {
    color: inherit;
    font-family: var(--font-redaction-50);
    text-decoration: none;
  }
  img { max-width: 100%; height: auto; }

  /* 960px content wrapper; breakout blocks (e.g. full-width images) sit outside it. */
  .wrap {
    box-sizing: border-box;
    max-width: calc(960px + 2rem);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* 800px text column, left-aligned inside .wrap. */
  .measure { max-width: 800px; }

  /* Big Redaction title + Inter Tight byline, shared by home and work pages. */
  .display {
    font-family: var(--font-redaction);
    font-size: 72px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }
  .lede {
    font-family: var(--font-inter-tight);
    font-size: 24px;
    font-weight: 500;
    line-height: 40px;
    margin: 0;
  }
  .lede a {
    display: inline-block;
    padding: 0 0.35em;
    border-radius: 0.3em;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
    text-decoration: none;
  }
  .lede a:hover {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
</style>
