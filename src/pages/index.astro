---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import site from '../data/site.json';
import { inlineLinks } from '../lib/inline';
---

<Base flushBottom>
  <div class="wrap">
    <h1 class="title">{site.intro}</h1>
    <p class="p1 byline" set:html={inlineLinks(site.byline)} />
  </div>
  <section class="grid-band" aria-label="Work">
    <div class="wrap">
      <WorkGrid />
      <p class="sign-off">Jeremy Chapple – Experience Designer</p>
    </div>
  </section>
</Base>

<style>
  .title { margin-bottom: 24px; }
  .byline { margin-bottom: 3rem; }
  /* Dark full-width band behind the grid; its solid colour hides the page texture. */
  .grid-band {
    background: var(--fg);
    padding-block: 64px;
    /* Light-on-dark text renders heavier on macOS; thinner smoothing evens it out. */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  /* Sign-off sits in the dark band, below a divider. */
  .sign-off {
    margin: 64px 0 0;
    padding-top: 32px;
    border-top: 1px solid color-mix(in srgb, var(--bg) 18%, transparent);
    color: var(--bg);
  }
</style>
