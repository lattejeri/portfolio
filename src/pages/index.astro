---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Escape the byline, then turn [text](url) into links so it stays editable as plain text in the CMS.
const escape = (str: string) =>
  str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const byline = escape(site.byline).replace(
  /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g,
  '<a href="$2">$1</a>',
);
---

<Base>
  <h1 class="intro">{site.intro}</h1>
  <p class="byline" set:html={byline} />
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}
        </time>
        <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .intro {
    font-family: var(--font-redaction);
    font-size: 72px;
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }
  .byline {
    font-family: var(--font-inter-tight);
    font-size: 24px;
    font-weight: 500;
    line-height: 40px;
    margin: 0 0 3rem;
  }
  .byline :global(a) {
    display: inline-block;
    padding: 0 0.35em;
    border-radius: 0.3em;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--fg);
    text-decoration: none;
  }
  .byline :global(a:hover) {
    background: color-mix(in srgb, var(--accent) 22%, transparent);
  }
  .posts { list-style: none; padding: 0; }
  .posts li { display: flex; gap: 1rem; padding: 0.35rem 0; }
  time { color: var(--muted); min-width: 7rem; font-variant-numeric: tabular-nums; }
</style>
