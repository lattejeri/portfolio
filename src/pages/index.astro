---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import site from '../data/site.json';
import { inlineLinks } from '../lib/inline';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <div class="wrap">
    <h1 class="title">{site.intro}</h1>
    <p class="p1 byline" set:html={inlineLinks(site.byline)} />
  </div>
  <section class="grid-band" aria-label="Work">
    <div class="wrap">
      <WorkGrid />
    </div>
  </section>
  <div class="wrap">
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}
          </time>
          <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .title { margin-bottom: 24px; }
  .byline { margin-bottom: 3rem; }
  /* Dark full-width band behind the grid; its solid colour hides the page texture. */
  .grid-band {
    background: var(--fg);
    padding-block: 64px;
    margin-bottom: 4rem;
  }
  .posts { list-style: none; padding: 0; }
  .posts li { display: flex; gap: 1rem; padding: 0.35rem 0; }
  time { color: var(--muted); min-width: 7rem; font-variant-numeric: tabular-nums; }
</style>
