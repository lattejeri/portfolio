---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base>
  <p>{site.intro}</p>
  <ul class="posts">
    {posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('en-GB', { dateStyle: 'medium' })}
        </time>
        <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts { list-style: none; padding: 0; }
  .posts li { display: flex; gap: 1rem; padding: 0.35rem 0; }
  time { color: var(--muted); min-width: 7rem; font-variant-numeric: tabular-nums; }
</style>
