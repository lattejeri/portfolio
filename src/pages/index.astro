---
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import site from '../data/site.json';
import { inlineLinks } from '../lib/inline';
---

<Base>
  <div class="wrap">
    <h1 class="title">{site.intro}</h1>
    <p class="p1 byline" set:html={inlineLinks(site.byline)} />
  </div>
  <section class="grid-band" aria-label="Work">
    <div class="wrap">
      <WorkGrid />
    </div>
  </section>
  <div class="wrap">
    <p class="sign-off">Jeremy Chapple – Experience Designer</p>
  </div>
</Base>

<style>
  .title { margin-bottom: 24px; }
  .byline { margin-bottom: 3rem; }
  /* Dark full-width band behind the grid; its solid colour hides the page texture. */
  .grid-band {
    background: var(--fg);
    padding-block: 64px;
    margin-bottom: 4rem;
  }
  .sign-off { margin: 0; }
</style>
